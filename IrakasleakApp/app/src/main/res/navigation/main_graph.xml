<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_graph"
    app:startDestination="@id/calendarFragment">

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.example.irakasleakapp.ui.calendar.CalendarFragment"
        android:label="Calendar" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.irakasleakapp.ui.searchUsers.SearchFragment"
        android:label="Search" >
        <action
            android:id="@+id/action_searchFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_searchFragment_to_searchDetailFragment"
            app:destination="@id/searchDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/addCalendarFragment"
        android:name="com.example.irakasleakapp.ui.addCalendar.AddCalendarFragment"
        android:label="Add" />
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.irakasleakapp.ui.settings.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/searchDetailFragment"
        android:name="com.example.irakasleakapp.ui.searchUsers.SearchDetailFragment"
        android:label="SearchDetailFragment" />
</navigation>